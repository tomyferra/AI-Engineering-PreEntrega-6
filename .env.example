# --- LLM de todos los agentes: "openai" | "anthropic" | "gemini" | "openrouter" ---
LLM_PROVIDER="openrouter"
# Opcional: pisa el modelo por defecto del provider (ver DEFAULT_MODEL_POR_PROVIDER en config.py).
# Recomendado: openai/gpt-4.1-mini (gpt-4o-mini confunde metas con resultados reales en las pruebas)
LLM_MODEL="openai/gpt-4.1-mini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
# Tope de tokens de salida por llamada (evita que el proveedor reserve el máximo del modelo)
LLM_MAX_TOKENS="2048"

# --- Opcional: búsqueda web para el investigador (sin esta key usa solo la base de conocimiento local) ---
TAVILY_API_KEY=""
